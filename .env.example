# Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# Model & Version Tracking
DEFAULT_EVAL_MODEL=gemini-2.0-flash-lite
MODEL_VERSION=1.0.0
PROMPT_VERSION=v1
RETRIEVER_VERSION=v1
EMBEDDING_MODEL=gemini-embedding-001

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=llm_eval_db
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@postgres:5432/llm_eval_db

# Streamlit
API_BASE_URL=http://localhost:8000/api/v1/eval

# Evaluation Thresholds
TOXICITY_THRESHOLD=0.10
HALLUCINATION_THRESHOLD=0.15
FAITHFULNESS_THRESHOLD=0.85
RELEVANCY_THRESHOLD=0.80

# Auth
JWT_SECRET_KEY=change-me-in-production-use-32-chars
JWT_EXPIRE_MINUTES=60

# Evaluator Settings
MOCK_EVALUATORS=false
GEMINI_MAX_CONCURRENT=5
GEMINI_MAX_RETRIES=3

# PII Policy: block | mask | redact
PII_POLICY=block

# Trace Sampling
TRACE_SAMPLE_RATE=0.05

# Alerting - leave blank to disable
ALERT_WEBHOOK_URL=
